# ── MongoDB ──────────────────────────────────────────────
# Local:  mongodb://localhost:27017/doctar
# Atlas:  mongodb+srv://user:pass@cluster.mongodb.net/doctar
MONGODB_URI=mongodb://localhost:27017/doctar

# ── Server ───────────────────────────────────────────────
PORT=8000
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Comma-separated list of allowed website origins (your frontend).
# Use * to allow any origin during development.
CORS_ORIGINS=http://localhost:3000

# ── AI / external APIs ───────────────────────────────────
# Google Gemini — primary AI for OCR, extraction, and chat
GEMINI_API_KEY=

# Google Cloud Vision OCR (optional; Gemini used when not set).
# Path to a service-account JSON key file.
GOOGLE_APPLICATION_CREDENTIALS=

# Google Places API — real-time live doctor search
GOOGLE_PLACES_API_KEY=

# OpenAI (optional fallback for text-based medicine extraction only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude — used for medicine information lookup (with web search)
ANTHROPIC_API_KEY=

# ── Feature flags ────────────────────────────────────────
# Force mock OCR + rule-based extraction (no external API calls)
USE_MOCK_OCR=false
# Only return real DB doctors (disables the Google Places / Gemini /
# deterministic-mock fallback chain entirely).
# Set to `true` for any environment pointing at the real shared doctar.in
# production database, so generated doctors can never appear as if they were
# real listings. Leave `false` for local prototyping, where the fallback chain
# is what makes every speciality+city search return results.
USE_REAL_DOCTOR_DB=false
# Only use real medicine DB (disable built-in fallback dict)
USE_REAL_MEDICINE_DB=false
